{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev Proxy CrudApiPlugin config schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The JSON schema reference for validation."
    },
    "apiFile": {
      "type": "string",
      "default": "api.json",
      "description": "Path to the file that contains the definition of the CRUD API."
    }
  },
  "required": [
    "apiFile"
  ],
  "additionalProperties": false
}